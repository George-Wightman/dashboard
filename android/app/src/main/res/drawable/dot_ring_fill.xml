<?xml version="1.0" encoding="utf-8"?>
<!-- A gold day (30 minutes or more): filled, with a ring round it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="13dp" android:height="13dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
