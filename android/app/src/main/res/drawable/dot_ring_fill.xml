<?xml version="1.0" encoding="utf-8"?>
<!-- A gold day (30 minutes or more): filled, with a ring round it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.4dp" android:color="#FFFFFF" />
            <size android:width="13dp" android:height="13dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
