<?xml version="1.0" encoding="utf-8"?>
<!-- A bit (under 15 minutes, tinted gold), or a Duolingo-only day (tinted muted): a ring with a small centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.6dp" android:color="#FFFFFF" />
            <size android:width="11dp" android:height="11dp" />
        </shape>
    </item>
    <item android:bottom="3.5dp" android:left="3.5dp" android:right="3.5dp" android:top="3.5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
