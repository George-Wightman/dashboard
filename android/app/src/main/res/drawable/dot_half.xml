<?xml version="1.0" encoding="utf-8"?>
<!-- A bit (under 15 minutes, tinted gold), or a Duolingo-only day (tinted muted): a ring with a small centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="11dp" android:height="11dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.6dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:width="4dp" android:height="4dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
