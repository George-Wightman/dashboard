<?xml version="1.0" encoding="utf-8"?>
<!-- The Hebrew widget (Widgets.hebrewViews): a label and a Hebrew word, the line, its aside, and the
     week as seven dots, in the Hebrew app's paper. The whole of it opens the Hebrew app; the time
     fetches it again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hebrew_day"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heb_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/heb_muted_day"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heb_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="@color/heb_muted_day"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/heb_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="3"
        android:paddingTop="6dp"
        android:textColor="@color/heb_ink_day"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/heb_aside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="3"
        android:paddingTop="3dp"
        android:textColor="@color/heb_muted_day"
        android:textSize="14sp"
        android:textStyle="italic" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/dot0" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot1" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot2" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot3" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot4" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot5" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot6" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:scaleType="center" android:src="@drawable/dot_ring" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="48dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="↻"
            android:textColor="@color/heb_muted_day"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/heb_gold_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
        android:src="@drawable/bar"
        android:visibility="gone" />
</LinearLayout>
