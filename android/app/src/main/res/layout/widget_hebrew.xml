<?xml version="1.0" encoding="utf-8"?>
<!-- The Hebrew widget (Widgets.hebrewViews), in the Hebrew app's paper: a label and a Hebrew word, then
     one card (encouragement, a big number, a word or phrase of the day, or the week's numbers), and the
     week as seven dots with their days. Sections not used by the card are hidden; the spacer takes
     what's left, so it fits a tall widget as well as a wide one. A tap opens the Hebrew app; a tap on
     the label fetches it again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hebrew_day"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="12dp"
    android:paddingEnd="13dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/heb_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heb_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:maxLines="2"
            android:textAllCaps="true"
            android:textColor="@color/heb_muted_day"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heb_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="@color/heb_muted_day"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <FrameLayout
        android:id="@+id/heb_top_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/heb_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:textColor="@color/heb_ink_day"
        android:textSize="72sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/heb_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="4"
        android:paddingTop="6dp"
        android:textColor="@color/heb_ink_day"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/heb_he"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="10dp"
        android:textColor="@color/heb_ink_day"
        android:textSize="36sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/heb_tr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:textColor="@color/heb_muted_day"
        android:textSize="17sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/heb_en"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="3"
        android:paddingTop="8dp"
        android:textColor="@color/heb_ink_day"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/heb_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:visibility="gone">

        <TextView android:id="@+id/stat_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:includeFontPadding="false" android:paddingTop="8dp" android:textColor="@color/heb_ink_day" android:textSize="28sp" />
        <TextView android:id="@+id/stat_t0" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:textColor="@color/heb_muted_day" android:textSize="11sp" />
        <TextView android:id="@+id/stat_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:includeFontPadding="false" android:paddingTop="8dp" android:textColor="@color/heb_ink_day" android:textSize="28sp" />
        <TextView android:id="@+id/stat_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:textColor="@color/heb_muted_day" android:textSize="11sp" />
        <TextView android:id="@+id/stat_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:includeFontPadding="false" android:paddingTop="8dp" android:textColor="@color/heb_ink_day" android:textSize="28sp" />
        <TextView android:id="@+id/stat_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:textColor="@color/heb_muted_day" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/heb_aside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="4"
        android:paddingTop="6dp"
        android:textColor="@color/heb_muted_day"
        android:textSize="15sp"
        android:textStyle="italic" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <ImageView android:id="@+id/dot0" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot1" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot2" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot3" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot4" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot5" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
        <ImageView android:id="@+id/dot6" android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/dot_ring" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView android:id="@+id/day0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
        <TextView android:id="@+id/day6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="@color/heb_muted_day" android:textSize="9sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/heb_gold_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitXY"
        android:src="@drawable/bar"
        android:visibility="gone" />
</LinearLayout>
