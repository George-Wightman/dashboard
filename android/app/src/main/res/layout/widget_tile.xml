<?xml version="1.0" encoding="utf-8"?>
<!-- One widget: a Daylight tile in small (Widgets.kt fills it in, colours and all). Its corners are
     rounded by its background; the launcher may round them further to match the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_day"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.75"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="end"
            android:text="↻"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/number_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/ink"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingBottom="5dp"
            android:text=""
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:paddingTop="4dp"
        android:text="@string/widget_waiting"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <!-- The Today widget's rows when they can be ticked (Widgets.kt): the row's text, and a ○ at its end
         that ticks it through the planner. A tap anywhere else still opens the dashboard. -->
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row0_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row0_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row1_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row2_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row3_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row4_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row4_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row5_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row5_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row6_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row6_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row7_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row7_tick"
                android:layout_width="40dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
